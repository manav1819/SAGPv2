{
  "name": "SAGP Cyberpunk Design System",
  "colors": {
    "background": "#0a0a1a",
    "backgroundDeep": "#070713",
    "surface": "#0f0f2e",
    "surface2": "#121236",
    "cyan": "#00f5ff",
    "green": "#39ff14",
    "purple": "#bf5fff",
    "danger": "#ff3b81",
    "warning": "#ffd166",
    "text": "#e6fbff",
    "textMuted": "rgba(207, 250, 254, 0.66)",
    "textSoft": "rgba(207, 250, 254, 0.48)"
  },
  "fonts": {
    "heading": "Orbitron",
    "body": "Exo 2",
    "mono": "IBM Plex Mono"
  },
  "radius": "4px",
  "container": "80rem",
  "effects": {
    "cardShadow": "0 0 0 1px rgba(57,255,20,0.04), 0 0 32px rgba(0,245,255,0.10), inset 0 0 24px rgba(191,95,255,0.05)",
    "cyanShadow": "0 0 22px rgba(0,245,255,0.28)",
    "neonText": "0 0 14px rgba(0,245,255,0.65), 0 0 28px rgba(191,95,255,0.28)",
    "glassBlur": "blur(14px)"
