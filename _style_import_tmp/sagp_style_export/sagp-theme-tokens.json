  "componentClasses": {
    "body": "sagp-body sagp-scanlines sagp-cyber-grid",
    "container": "sagp-container",
    "navbar": "sagp-navbar",
    "mobileTabs": "sagp-mobile-tabs",
    "card": "sagp-card sagp-neon-card",
    "buttonPrimary": "sagp-btn sagp-btn-primary",
    "buttonSecondary": "sagp-btn sagp-btn-secondary",
    "buttonGhost": "sagp-btn sagp-btn-ghost",
    "buttonDanger": "sagp-btn sagp-btn-danger",
    "input": "sagp-input",
    "select": "sagp-select",
    "badge": "sagp-badge",
    "progress": "sagp-progress > sagp-progress-bar",
    "moduleGrid": "sagp-module-grid",
    "gameShellGrid": "sagp-game-shell-grid",
    "table": "sagp-table"
  }
